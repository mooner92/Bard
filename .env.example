# 복사해서 .env 로 만들고 실제 값을 채우세요. .env 는 git에 올라가지 않습니다.
AZURE_SPEECH_KEY=여기에_키1_붙여넣기
AZURE_SPEECH_REGION=koreacentral
# 한국어: ko-KR-SunHiNeural(여) / ko-KR-InJoonNeural(남)
# 영어:   en-US-AvaMultilingualNeural / en-US-AndrewMultilingualNeural
AZURE_TTS_VOICE=ko-KR-SunHiNeural

# --- 도서 API (docs/PLAN.md P4) ---
# 도서관 정보나루 (data4library.kr) 인증키 — 인기대출도서 조회용
# 일 기본 500회 제한(IP 미등록 기준). 주 1회 배치라 여유 큼.
DATA4LIBRARY_KEY=여기에_발급키
# KEI 도서관은 별도 API 키 없음 — 자료검색을 통해 소장 여부/형태(종이책·전자책) 확인
KEI_LIBRARY_BASE=https://library.kei.re.kr
